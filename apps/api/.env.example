# Copy to apps/api/.env for local development (never commit the real .env).
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PORT=4000
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/event_platform

# Required, 32+ characters: the API refuses to start without them
JWT_SECRET=
QR_HMAC_SECRET=

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000

# DEMO_MODE=true            # default: on in development/test only (seeds password123 demo accounts)
# ENABLE_SIMULATION=true    # default: follows DEMO_MODE
# ADMIN_EMAIL=              # outside demo mode: ADMIN created on an empty database
# ADMIN_PASSWORD=           # 12+ characters
